<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标：一块竖直的屏 + 一个向右的投送箭头。
  含义是"把画面投到另一块屏上"，和 FlipMirror 的功能直接对应。
  纯矢量，任何密度都清晰；配色沿用深底 + 青色高亮，和控件条一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色：圆角方块 -->
    <path
        android:fillColor="#12151C"
        android:pathData="M24,12 L84,12 A12,12 0 0 1 96,24 L96,84 A12,12 0 0 1 84,96 L24,96 A12,12 0 0 1 12,84 L12,24 A12,12 0 0 1 24,12 Z" />

    <!-- 竖屏框（代表手机屏） -->
    <path
        android:strokeColor="#4EA1FF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:pathData="M34,30 L62,30 A5,5 0 0 1 67,35 L67,81 A5,5 0 0 1 62,86 L34,86 A5,5 0 0 1 29,81 L29,35 A5,5 0 0 1 34,30 Z" />

    <!-- 屏内两道内容线 -->
    <path
        android:strokeColor="#2E6DB4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,44 L58,44" />
    <path
        android:strokeColor="#2E6DB4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,56 L52,56" />

    <!-- 投送箭头 -->
    <path
        android:strokeColor="#3DDC97"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M72,58 L86,58 M80,52 L86,58 L80,64" />
</vector>
